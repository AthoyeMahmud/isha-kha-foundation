---
import '../../styles/global.css';
import { concepts } from '../../data/concepts';
const directions = [
 { title:'Living heritage', bn:'জীবন্ত ঐতিহ্য', composition:'The editorial approach', desc:'A generous opening, an archival portrait and a calm reading rhythm. The history and the foundation’s present-day purpose share the page.', fit:'Best for a balanced institutional identity.' },
 { title:'The public record', bn:'ইতিহাসের দলিল', composition:'The reading-room approach', desc:'A forest-green opening and a subject index lead into an open collection. Documents and their context become the visual language.', fit:'Best for an archive and research-led identity.' },
 { title:'A shared future', bn:'আমাদের আগামী', composition:'The community approach', desc:'A Bengali-led typographic welcome gives way to a bold field of green. Social purpose leads; heritage gives it depth.', fit:'Best for a contemporary, people-centred identity.' },
];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><meta name="description" content="Three responsive homepage directions for Isha Kha Foundation, in English and Bangla."/><link rel="icon" href="/favicon.svg"/><title>Three homepage directions · Isha Kha Foundation</title></head>
<body>
  <a class="skip-link" href="#main">Skip to concepts</a>
  <header class="review-header wrap"><a href="/">Isha Kha Foundation<span>Isa Khan alias Isha Kha Foundation</span></a><p>Homepage design studies <span>October 2026</span></p></header>
  <main id="main" class="wrap" tabindex="-1">
    <div class="review-intro"><div><p lang="bn">ঐতিহ্যের সাথে, মানুষের পাশে।</p><h1>Three ways to carry<br/>a legacy forward.</h1></div><div><p>One foundation. Three distinct homepage directions. Explore each in English or Bangla, then choose the composition that feels right.</p><p class="review-note">These are homepage concepts. Text, the proposed typographic mark and archival assets are subject to approval.</p></div></div>
    <div class="concept-grid">{concepts.map((concept,i)=> { const d=directions[i]; return <article>
      <a class="concept-preview" href={`/en/${concept.slug}/`} aria-label={`Explore ${d.title} in English`}>
        <img src={`/concepts/${concept.slug}.webp`} width="1440" height="1000" alt="" loading="lazy" decoding="async" />
      </a>
      <p class="direction-label">{d.composition}</p><h2>{d.title}</h2><p lang="bn" class="direction-bn">{d.bn}</p><p class="direction-desc">{d.desc}</p><p class="direction-fit">{d.fit}</p><div class="direction-links"><a href={`/en/${concept.slug}/`}>Explore in English <span aria-hidden="true">↗</span></a><a lang="bn" href={`/bn/${concept.slug}/`}>বাংলায় দেখুন <span aria-hidden="true">↗</span></a></div>
    </article>; })}</div>
    <section class="review-details" aria-label="Shared design principles"><p>Forest green. Warm ivory. Muted copper.</p><p>Static Astro pages · Local English and Bengali fonts · Responsive layouts · Native navigation · No client-side JavaScript</p></section>
  </main><footer class="review-footer wrap"><p>Choose a homepage direction before extending the site.</p><p>Foundation / Heritage / Activities / Archive / Documents / Contact</p></footer>
</body></html>
<style>
.review-header { padding-block: 2.5rem; display: flex; justify-content: space-between; align-items: center; gap: 2rem; border-bottom: 1px solid var(--line); }
.review-header > a { font-family: var(--serif); text-decoration: none; font-size: 1.3rem; }
.review-header a span { font-family: var(--sans); font-size: .6rem; display: block; color: var(--muted); margin-top: .3rem; }
.review-header > p { font-size: .72rem; text-align: right; }
.review-header p span { display: block; color: var(--muted); }
.review-intro { display: grid; grid-template-columns: 1.4fr 1fr; gap: 10%; align-items: end; padding-block: 4.5rem; }
.review-intro > div > p:lang(bn) { font-family: 'Bengali Serif'; color: var(--copper); font-size: 1.1rem; margin-bottom: 1rem; }
h1 { font-size: clamp(2.7rem, 4.8vw, 4.5rem); letter-spacing: -.045em; }
.review-intro > div:last-child p { font-size: .9rem; color: var(--muted); line-height: 1.9; }
.review-intro > div:last-child .review-note { font-size: .72rem; margin-top: 1rem; }
.concept-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.1rem; }
.concept-preview { display: block; background: var(--paper); border: 1px solid var(--line); }
.concept-preview img { display: block; width: 100%; height: auto; }
.direction-label { font-size: .7rem; color: var(--copper); margin-block: 1.7rem .5rem; }
.concept-grid h2 { font-size: 1.8rem; }
.direction-bn { font-family: 'Bengali Serif'; font-size: .95rem; color: var(--muted); margin-block: .3rem 1rem; }
.direction-desc { font-size: .8rem; line-height: 1.9; min-height: 8em; }
.direction-fit { font-size: .72rem; color: var(--muted); border-top: 1px solid var(--line); padding-top: 1.1rem; margin-top: 1rem; }
.direction-links { display: flex; flex-wrap: wrap; gap: 1.4rem; font-size: .75rem; margin-top: .7rem; }
.direction-links a { display: flex; align-items: center; gap: .5rem; min-height: 44px; }
.review-details { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-top: 4rem; padding-block: 2rem; border-block: 1px solid var(--line); font-size: .75rem; }
.review-details p:last-child { color: var(--muted); }
.review-footer { display: flex; justify-content: space-between; gap: 3rem; padding-block: 2rem 3rem; font-size: .65rem; color: var(--muted); }
@media (max-width: 900px) {
 .review-intro { gap: 5%; grid-template-columns: 1.2fr 1fr; }
 .concept-grid { gap: 1.2rem; }
 .direction-desc { min-height: 11em; }
 .concept-grid h2 { font-size: 1.4rem; }
}
@media (max-width: 650px) {
 .review-header { padding-block: 1.5rem; align-items: flex-start; gap: 1rem; }
 .review-header > a { font-size: 1rem; }
 .review-header > p { font-size: .6rem; }
 .review-header a span { font-size: .49rem; }
 .review-intro { grid-template-columns: 1fr; padding-block: 2.5rem; gap: 1.8rem; }
 .review-intro h1 { font-size: 2.7rem; }
 .concept-grid { grid-template-columns: 1fr; gap: 3rem; }
 .direction-label { margin-top: 1.2rem; }
 .concept-grid h2 { font-size: 1.9rem; }
 .direction-desc { min-height: 0; max-width: 45ch; }
 .review-details { grid-template-columns: 1fr; gap: 1rem; margin-top: 3rem; }
 .review-footer { flex-direction: column; gap: 1rem; }
 .direction-links { font-size: .85rem; }
}
</style>

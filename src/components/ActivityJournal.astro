---
import { Image } from 'astro:assets';
import { activities, channelUrl } from '../data/foundation';
import type { Lang } from '../data/concepts';
import jangalbari from '../assets/activities/jangalbari-visit.webp';
import discussion from '../assets/activities/history-discussion.webp';
const { lang = 'en' } = Astro.props as { lang: Lang };
const t = (en: string, bn: string) => lang === 'bn' ? bn : en;
const publishedDateFormatter = new Intl.DateTimeFormat(lang === 'bn' ? 'bn-BD' : 'en-GB', { dateStyle: 'long', timeStyle: 'short', hourCycle: 'h23', timeZone: 'Asia/Dhaka' });
---
<div class="activity-journal">
  <p class="journal-source">{t('Event dates describe when activities took place. Posted timestamps show when the foundation published each YouTube post, in Dhaka time (UTC+06:00).', 'অনুষ্ঠানের তারিখ কার্যক্রম সংঘটনের সময় নির্দেশ করে। পোস্ট প্রকাশের তারিখ ও সময় ফাউন্ডেশনের ইউটিউব পোস্ট প্রকাশের সময়; ঢাকা সময়ে (UTC+06:00) প্রদর্শিত।')}</p>
  <div class="journal-photographs">
    <figure><Image src={jangalbari} widths={[320, 640]} sizes="(max-width: 700px) 88vw, 44vw" alt={t('Nasima Sultana Ratna pictured beside a historic building during the visit identified by the channel as Jangalbari.', 'চ্যানেলে জঙ্গলবাড়ী পরিদর্শন হিসেবে বর্ণিত আলোকচিত্রে একটি পুরোনো ভবনের পাশে নাসিমা সুলতানা রত্না।')} format="webp" /><figcaption><a href={activities[1].source}>{t('Jangalbari visit · Source photograph', 'জঙ্গলবাড়ী পরিদর্শন · উৎস আলোকচিত্র')}</a></figcaption></figure>
    <figure><Image src={discussion} widths={[320, 640]} sizes="(max-width: 700px) 88vw, 44vw" alt={t('Participants, including students, holding books during an Isa Khan discussion programme pictured by the foundation.', 'ফাউন্ডেশনের প্রকাশিত ঈশা খাঁবিষয়ক আলোচনা অনুষ্ঠানের ছবিতে শিক্ষার্থীসহ অংশগ্রহণকারীরা বই হাতে।')} format="webp" /><figcaption><a href={activities[3].source}>{t('Isa Khan discussion programme · Source photograph', 'ঈশা খাঁবিষয়ক আলোচনা অনুষ্ঠান · উৎস আলোকচিত্র')}</a></figcaption></figure>
  </div>
  <div class="journal-entries">
    {activities.slice(0, 6).map(entry => <article data-activity={entry.id}>
      <div class="entry-dates">
        <p>{t('Event date:', 'অনুষ্ঠানের তারিখ:')} {'eventDateTime' in entry ? <time datetime={entry.eventDateTime}>{entry.eventDate[lang]}</time> : entry.eventDate[lang]}</p>
        <p>{t('Posted:', 'পোস্ট প্রকাশ:')} <time data-posted-at={entry.id} datetime={entry.publishedAt}>{publishedDateFormatter.format(new Date(entry.publishedAt))}</time> {t('(Dhaka)', '(ঢাকা সময়)')}</p>
      </div>
      <h3>{entry.title[lang]}</h3><p>{entry.description[lang]}</p>
      <a class="entry-source" href={entry.source} aria-label={`${t('Read the original post', 'মূল পোস্ট পড়ুন')}: ${entry.title[lang]}`}>{t('Read the original post', 'মূল পোস্ট পড়ুন')} <span aria-hidden="true">↗</span></a>
    </article>)}
  </div>
  <details class="earlier-records"><summary>{t('More activities and historical records', 'আরও কার্যক্রম ও পুরোনো নথি')} <span aria-hidden="true">+</span></summary>
    <div class="journal-entries">{activities.slice(6).map(entry => <article data-activity={entry.id}>
      <div class="entry-dates">
        <p>{t('Event date:', 'অনুষ্ঠানের তারিখ:')} {'eventDateTime' in entry ? <time datetime={entry.eventDateTime}>{entry.eventDate[lang]}</time> : entry.eventDate[lang]}</p>
        <p>{t('Posted:', 'পোস্ট প্রকাশ:')} <time data-posted-at={entry.id} datetime={entry.publishedAt}>{publishedDateFormatter.format(new Date(entry.publishedAt))}</time> {t('(Dhaka)', '(ঢাকা সময়)')}</p>
      </div>
      <h3>{entry.title[lang]}</h3><p>{entry.description[lang]}</p><a class="entry-source" href={entry.source} aria-label={`${t('Read the original post', 'মূল পোস্ট পড়ুন')}: ${entry.title[lang]}`}>{t('Read the original post', 'মূল পোস্ট পড়ুন')} <span aria-hidden="true">↗</span></a>
    </article>)}</div>
  </details>
  <a class="channel-link" href={channelUrl}>{t('Explore the foundation’s YouTube posts', 'ফাউন্ডেশনের ইউটিউব পোস্ট দেখুন')} <span aria-hidden="true">↗</span></a>
</div>
<style>
.activity-journal { margin-top: 2rem; }
.journal-source { font-size: .8rem; line-height: 1.9; max-width: 78ch; }
.journal-photographs { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-block: 2rem 2.5rem; }
figure { margin: 0; min-width: 0; }
img { display: block; width: 100%; height: auto; max-height: 390px; object-fit: contain; background: var(--paper); }
figcaption { font-size: .75rem; line-height: 1.75; padding-block: .75rem; }
figcaption a { display: inline-block; min-height: 32px; padding-top: .25rem; }
.journal-entries { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 3rem; }
article { border-top: 1px solid currentColor; padding-top: 1rem; min-width: 0; }
.entry-dates { font-size: .73rem; line-height: 1.8; margin-bottom: .65rem; }
h3 { font-family: var(--serif); font-size: 1.55rem; line-height: 1.4; margin-bottom: .8rem; }
article > p { font-size: .86rem; line-height: 1.9; }
.entry-source, .channel-link { display: inline-flex; align-items: center; gap: .75rem; min-height: 44px; font-size: .8rem; margin-top: .5rem; }
.earlier-records { margin-top: 2rem; border-block: 1px solid currentColor; }
summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; cursor: pointer; list-style: none; min-height: 56px; padding-block: .85rem; font-size: .9rem; }
summary::-webkit-details-marker { display: none; }
details[open] summary { margin-bottom: 1.5rem; }
details[open] summary span { transform: rotate(45deg); }
details .journal-entries { padding-bottom: 1.5rem; }
.channel-link { margin-top: 1.5rem; }
:global(.activities-section) a:focus-visible, :global(.activities-section) summary:focus-visible, :global(.activity-band) a:focus-visible, :global(.activity-band) summary:focus-visible { outline-color: #e4bda0; }
@media (max-width: 700px) {
  .journal-photographs, .journal-entries { grid-template-columns: 1fr; gap: 1.7rem; }
  .journal-photographs { margin-block: 1.7rem; }
  img { max-height: none; }
  h3 { font-size: 1.4rem; }
}
</style>

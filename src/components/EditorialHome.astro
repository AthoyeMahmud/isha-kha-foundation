---
import ArchiveObject from './ArchiveObject.astro';
import ActivityJournal from './ActivityJournal.astro';
import Publications from './Publications.astro';
import { foundationProfile, heritageReferences } from '../data/foundation';
const { lang = 'en' } = Astro.props;
const t = (en: string, bn: string) => lang === 'bn' ? bn : en;
---
<section class="editorial-hero wrap" id="heritage" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <h1 id="hero-heading">{t('Isha Kha\nFoundation', 'ঈশা খাঁ\nফাউন্ডেশন')}</h1>
    <p class="hero-subtitle" lang="en">Isa Khan alias Isha Kha Foundation</p>
    <p class="hero-intro">{t('The foundation’s work includes heritage visits, publications, historical discussions and cultural programmes. Education and social welfare are among its founding aims.', 'ফাউন্ডেশনের কার্যক্রমের মধ্যে রয়েছে ঐতিহ্যবাহী স্থান পরিদর্শন, প্রকাশনা, ইতিহাসবিষয়ক আলোচনা ও সাংস্কৃতিক অনুষ্ঠান। শিক্ষা ও সমাজকল্যাণও প্রতিষ্ঠার লক্ষ্যগুলোর অন্তর্ভুক্ত।')}</p>
    <div class="hero-actions"><a class="button" href="#foundation">{t('Discover the foundation', 'ফাউন্ডেশন সম্পর্কে জানুন')} <span aria-hidden="true">↗</span></a><a class="text-link" href="#activities">{t('View activities', 'কার্যক্রম দেখুন')}</a></div>
  </div>
  <div class="hero-exhibit">
    <div class="exhibit-top"><span>{t('From the collection', 'সংগ্রহ থেকে')}</span><span lang="bn">ঈশা খাঁ</span></div>
    <ArchiveObject lang={lang} eager />
    <span class="exhibit-side" aria-hidden="true">বাংলার ঐতিহ্য</span>
  </div>
</section>
<section class="foundation wrap" id="foundation" aria-labelledby="foundation-heading">
  <div><p class="section-label">{t('The foundation', 'ফাউন্ডেশন')}</p><h2 id="foundation-heading">{t('Rooted in history.\nPresent for people.', 'ইতিহাসে শিকড়।\nমানুষের পাশে।')}</h2></div>
  <div class="foundation-copy"><p>{foundationProfile[lang]}</p><a class="text-link" href="https://www.youtube.com/post/Ugkx91aHMM9mZmUleuVvKeVnxBQ0kQVII_ZM">{t('Foundation profile on YouTube', 'ইউটিউবে ফাউন্ডেশনের পরিচিতি')} ↗</a><p class="copy-note">{t('The activities below come from the public record. The founding documents describe the foundation’s broader aims.', 'নিচের কার্যক্রম প্রকাশ্য পোস্ট থেকে নেওয়া। প্রতিষ্ঠার নথিতে ফাউন্ডেশনের বিস্তৃত লক্ষ্য বর্ণিত আছে।')}</p><a class="text-link" href="#documents">{t('Read about our founding aims', 'প্রতিষ্ঠার লক্ষ্য সম্পর্কে পড়ুন')} ↗</a></div>
</section>
<section class="work-section" id="activities" aria-labelledby="activities-heading"><div class="wrap">
  <div class="section-heading"><div><p class="section-label">{t('Purpose in the present', 'বর্তমানের অঙ্গীকার')}</p><h2 id="activities-heading">{t('Heritage is also how we care.', 'ঐতিহ্য মানে মানুষের যত্নও।')}</h2></div><p>{t('Visits, discussion and public engagement', 'পরিদর্শন, আলোচনা ও জনসম্পৃক্ততা')}</p></div>
  <ActivityJournal lang={lang} />
</div></section>
<section class="collection wrap" id="archive" aria-labelledby="archive-heading">
  <div class="collection-intro"><p class="section-label">{t('The collection', 'সংগ্রহশালা')}</p><h2 id="archive-heading">{t('Fragments of a\ncontinuing story.', 'চলমান ইতিহাসের\nকিছু খণ্ডচিত্র।')}</h2><p>{t('Photographs, printed material and documents offer ways into the foundation’s story. Each item deserves its source, its context and a careful reading.', 'আলোকচিত্র, মুদ্রিত উপকরণ ও নথিপত্র ফাউন্ডেশনের ইতিহাস জানার পথ খুলে দেয়। প্রতিটি উপকরণের উৎস ও প্রেক্ষাপট সংরক্ষণ জরুরি।')}</p></div>
  <div class="archive-list"><article><span>{t('Visual record', 'দৃশ্যমান ইতিহাস')}</span><h3>{t('Isa Khan in a postage stamp', 'ডাকটিকিটে ঈশা খাঁ')}</h3><p>{t('The photographed commemorative image featured above, from the supplied material.', 'সরবরাহকৃত উপকরণ থেকে নেওয়া স্মারক ডাকটিকিটের আলোকচিত্র, যা ওপরে প্রদর্শিত।')}</p></article><article><span>{t('From the channel archive', 'চ্যানেলের সংগ্রহ থেকে')}</span><h3>{t('Heritage photographs & references', 'ঐতিহ্যের আলোকচিত্র ও তথ্যসূত্র')}</h3><p>{t('The channel shares place photographs and references to published writing on Isa Khan.', 'চ্যানেলে ঈশা খাঁবিষয়ক স্থান-আলোকচিত্র ও প্রকাশিত লেখার সূত্র রয়েছে।')}</p>{heritageReferences.map(item => <a class="text-link reference-link" href={item.source}>{item.title[lang]} ↗</a>)}</article></div>
</section>
<Publications lang={lang} />
<section class="documents wrap" id="documents" aria-labelledby="documents-heading"><div><p class="section-label">{t('Institutional record', 'প্রাতিষ্ঠানিক নথি')}</p><h2 id="documents-heading">{t('A foundation, in its own words.', 'নথিতে ফাউন্ডেশনের পরিচয়।')}</h2></div><div class="document-notes"><details><summary>{t('Constitution & founding aims', 'গঠনতন্ত্র ও প্রতিষ্ঠার লক্ষ্য')} <span aria-hidden="true">+</span></summary><p>{t('The supplied constitution describes heritage preservation, education, social welfare and cultural activities among the foundation’s aims. An approved public copy is to be added.', 'সরবরাহকৃত গঠনতন্ত্রে ঐতিহ্য সংরক্ষণ, শিক্ষা, সমাজকল্যাণ ও সাংস্কৃতিক কার্যক্রমসহ ফাউন্ডেশনের লক্ষ্য বর্ণিত আছে। অনুমোদিত প্রকাশ্য অনুলিপি যুক্ত করা হবে।')}</p></details><details><summary>{t('Registration documents', 'নিবন্ধনসংক্রান্ত নথি')} <span aria-hidden="true">+</span></summary><p>{t('Registration material is present in the supplied collection. A reviewed public copy and accessible transcription are pending.', 'সরবরাহকৃত সংগ্রহে নিবন্ধনসংক্রান্ত নথি আছে। পর্যালোচিত প্রকাশ্য অনুলিপি ও পাঠযোগ্য প্রতিলিপি প্রস্তুত করা হবে।')}</p></details></div></section>
<style>
.editorial-hero {
  display:grid;
  grid-template-columns:1.15fr 1fr;
  gap:6%;
  padding-top:2rem;
  padding-bottom:5rem;
  align-items:center;
}
.hero-copy {
  padding-block:1rem;
}
h1 {
  font-size:clamp(2.6rem,5.1vw,5rem);
  line-height:1.16;
  letter-spacing:-.045em;
  white-space:pre-line;
}
.hero-subtitle {
  font-family:'Foundation Sans',sans-serif;
  font-size:.9rem;
  line-height:1.65;
  color:var(--copper);
  margin-top:1.1rem;
}
.hero-intro {
  font-size:.96rem;
  line-height:1.9;
  max-width:43ch;
  margin-top:1.8rem;
  color:var(--muted);
}
.hero-actions {
  display:flex;
  align-items:center;
  gap:1.6rem;
  margin-top:2rem;
  flex-wrap:wrap;
}
.hero-exhibit {
  background:var(--green);
  color:var(--ivory);
  padding:1.6rem 2.7rem 1.8rem;
  position:relative;
}
.exhibit-top {
  display:flex;
  justify-content:space-between;
  align-items:center;
  font-size:.63rem;
  margin-bottom:1.3rem;
  color:#d7d9cb;
}
.exhibit-top span:lang(bn) {
  font-family:'Bengali Serif';
  font-size:1rem;
}
.hero-exhibit :global(.object-mount) {
  padding:1.3rem 2.2rem;
  background:#e4ddcb;
}
.hero-exhibit :global(img) {
  height:370px;
  width:100%;
  object-fit:contain;
}
.hero-exhibit :global(figcaption) {
  font-size:.65rem;
}
.exhibit-side {
  position:absolute;
  right:.6rem;
  top:48%;
  font-family:'Bengali Serif';
  writing-mode:vertical-rl;
  font-size:.65rem;
  color:#d2d6c4;
}
.foundation {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10%;
  border-top:1px solid var(--line);
  padding-block:4.7rem 5rem;
}
.section-label {
  font-size:.73rem;
  color:var(--copper);
  margin-bottom:1.15rem;
}
.foundation h2,.collection h2 {
  font-size:clamp(2rem,3vw,3.2rem);
  white-space:pre-line;
  letter-spacing:-.035em;
}
.foundation-copy {
  padding-top:.2rem;
}
.foundation-copy>p {
  font-size:.9rem;
  line-height:1.95;
}
.foundation-copy .copy-note {
  font-size:.74rem;
  color:var(--muted);
  margin-top:1.2rem;
}
.foundation-copy a {
  margin-top:.5rem;
}
.work-section {
  background:var(--paper);
  padding-block:4.5rem;
}
.section-heading {
  display:flex;
  gap:4rem;
  align-items:flex-end;
  justify-content:space-between;
}
.section-heading h2 {
  font-size:clamp(1.8rem,2.5vw,2.5rem);
}
.section-heading>p {
  font-size:.72rem;
  max-width:22ch;
  color:var(--muted);
  padding-bottom:.3rem;
}
.collection {
  padding-block:5rem;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12%;
}
.collection-intro>p:last-child {
  font-size:.85rem;
  color:var(--muted);
  margin-top:1.5rem;
}
.archive-list article {
  border-top:1px solid var(--line);
  padding-block:1.5rem;
}
.archive-list article>span {
  color:var(--copper);
  font-size:.68rem;
}
.archive-list h3 {
  font-size:1.5rem;
  margin-block:.6rem;
}
.archive-list p {
  font-size:.8rem;
  color:var(--muted);
}
.documents {
  border-top:1px solid var(--line);
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12%;
  padding-block:3.5rem 5rem;
}
.documents h2 {
  font-size:2rem;
}
.document-notes details {
  border-top:1px solid var(--line);
}
.document-notes details:last-child {
  border-bottom:1px solid var(--line);
}
summary {
  list-style:none;
  cursor:pointer;
  display:flex;
  justify-content:space-between;
  gap:1rem;
  align-items:center;
  padding:1.2rem 0;
  font-size:.85rem;
  min-height:48px;
}
summary::-webkit-details-marker {
  display:none;
}
details p {
  font-size:.8rem;
  padding-bottom:1.5rem;
  color:var(--muted);
}
details[open] summary span {
  transform:rotate(45deg);
}
@media(min-width:1500px) {
  .hero-exhibit :global(img) {
    height:420px;
  }
}
@media(max-width:1000px) {
  .editorial-hero {
    gap:4%;
    grid-template-columns:1.1fr 1fr;
  }
  .hero-exhibit {
    padding:1.3rem 1.5rem;
  }
  .hero-exhibit :global(.object-mount) {
    padding:1rem;
  }
  .hero-exhibit :global(img) {
    height:320px;
  }
  .hero-actions {
    gap:1rem;
  }
  .hero-actions .button {
    font-size:.75rem;
    padding-inline:1rem;
  }
  .hero-actions .text-link {
    font-size:.75rem;
  }
}
@media(max-width:700px) {
  .editorial-hero {
    grid-template-columns:1fr;
    gap:2.6rem;
    padding-top:1.3rem;
    padding-bottom:3rem;
  }
  h1 {
    font-size:clamp(2.6rem,11vw,4rem);
    letter-spacing:-.04em;
  }
  .hero-intro {
    font-size:.9rem;
    margin-top:1.4rem;
  }
  .hero-actions {
    margin-top:1.4rem;
    gap:1rem;
  }
  .hero-exhibit {
    padding:1.2rem 2rem 1.4rem;
  }
  .hero-exhibit :global(img) {
    height:300px;
  }
  .hero-exhibit :global(.object-mount) {
    padding:1.3rem;
  }
  .foundation {
    grid-template-columns:1fr;
    gap:2rem;
    padding-block:3rem;
  }
  .foundation h2,.collection h2 {
    font-size:2.3rem;
  }
  .section-heading {
    display:block;
  }
  .section-heading>p {
    margin-top:1rem;
    max-width:none;
  }
  .work-section {
    padding-block:3rem;
  }
  .collection,.documents {
    grid-template-columns:1fr;
    gap:2rem;
    padding-block:3rem;
  }
  .collection-intro>p:last-child {
    margin-top:1rem;
  }
  .documents h2 {
    font-size:2rem;
  }
  .hero-exhibit .exhibit-side {
    right:.4rem;
  }
}
:global(html[lang='bn']) h1 {
  line-height:1.5;
  font-size:clamp(2.5rem,4vw,4.1rem);
  letter-spacing:0;
}
:global(html[lang='bn']) h2 {
  line-height:1.5;
  letter-spacing:0;
}
</style>

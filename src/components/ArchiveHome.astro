---
import ArchiveObject from './ArchiveObject.astro';
import ActivityJournal from './ActivityJournal.astro';
import Publications from './Publications.astro';
import { foundationProfile, heritageReferences } from '../data/foundation';

interface Props {
  lang: 'en' | 'bn';
}

const { lang } = Astro.props;
const t = (en: string, bn: string) => lang === 'bn' ? bn : en;

const subjects = [
  { id: 'foundation', en: 'The foundation', bn: 'ফাউন্ডেশন' },
  { id: 'heritage', en: 'History & heritage', bn: 'ইতিহাস ও ঐতিহ্য' },
  { id: 'activities', en: 'Areas of activity', bn: 'কার্যক্রমের ক্ষেত্র' },
  { id: 'archive', en: 'The archive', bn: 'সংগ্রহশালা' },
  { id: 'documents', en: 'Public documents', bn: 'প্রকাশ্য নথিপত্র' },
  { id: 'contact', en: 'Contact & enquiries', bn: 'যোগাযোগ ও অনুসন্ধান' },
];

---

<section class="reading-room" id="heritage" aria-labelledby="record-title">
  <div class="wrap">
    <div class="room-heading">
      <p>{t('The public record', 'জনস্মৃতির নথি')}</p>
      <p>{t('Bengal · History · Public life', 'বাংলা · ইতিহাস · জনজীবন')}</p>
    </div>
    <div class="opening">
      <p class="opening-label">{t('A legacy worth returning to', 'ফিরে দেখার মতো এক উত্তরাধিকার')}</p>
      <h1 id="record-title">{t('History, held in common.', 'ইতিহাস সবার। উত্তরাধিকারও।')}</h1>
      <div class="opening-bottom">
        <span class="opening-mark" aria-hidden="true">ই</span>
        <p>{t('Explore Isa Khan’s legacy and Bengal’s history, alongside a foundation’s commitment to social welfare, education and culture.', 'ঈশা খাঁর উত্তরাধিকার ও বাংলার ইতিহাসকে জানুন—সমাজকল্যাণ, শিক্ষা ও সংস্কৃতির প্রতি ফাউন্ডেশনের অঙ্গীকারের সঙ্গে।')}</p>
      </div>
    </div>
    <nav class="subject-index" aria-label={t('Homepage subject index', 'মূল পাতার বিষয়সূচি')}>
      <p class="index-title">{t('Begin with a subject', 'বিষয় ধরে পড়ুন')}</p>
      <ol>
        {subjects.map((subject, index) => (
          <li>
            <a href={`#${subject.id}`}>
              <span class="subject-number" aria-hidden="true">{lang === 'bn' ? ['০১', '০২', '০৩', '০৪', '০৫', '০৬'][index] : String(index + 1).padStart(2, '0')}</span>
              <span>{t(subject.en, subject.bn)}</span>
              <span class="subject-arrow" aria-hidden="true">↘</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<section class="foundation-section" id="foundation" aria-labelledby="foundation-title">
  <div class="wrap foundation-layout">
    <div class="section-sidebar">
      <p class="section-kicker">{t('The foundation', 'ফাউন্ডেশন')}</p>
      <p class="foundation-name">{t('Isha Kha Foundation', 'ঈশা খাঁ ফাউন্ডেশন')}</p>
      <p class="foundation-alias">{t('Isa Khan alias Isha Kha Foundation', 'ঈশা খান ওরফে ঈশা খাঁ ফাউন্ডেশন')}</p>
    </div>
    <div class="foundation-statement">
      <h2 id="foundation-title">{t('Memory is a public responsibility.', 'স্মৃতিকে বাঁচিয়ে রাখা সামাজিক দায়িত্ব।')}</h2>
      <p>{foundationProfile[lang]}</p><a class="text-link" href="https://www.youtube.com/post/Ugkx91aHMM9mZmUleuVvKeVnxBQ0kQVII_ZM">{t('Foundation profile on YouTube', 'ইউটিউবে ফাউন্ডেশনের পরিচিতি')} ↗</a>
      <p>{t('Its purpose connects the preservation of heritage with social welfare, education and cultural life. This website is a place to understand that purpose and explore the materials that inform it.', 'ঐতিহ্য সংরক্ষণ, সমাজকল্যাণ, শিক্ষা ও সাংস্কৃতিক জীবনকে একসূত্রে দেখাই এর উদ্দেশ্য। এই ওয়েবসাইট সেই উদ্দেশ্য বোঝার এবং সংশ্লিষ্ট উপকরণ জানার একটি পরিসর।')}</p>
      <a class="text-link" href="#activities">{t('Read about the areas of activity', 'কার্যক্রমের ক্ষেত্রগুলো জানুন')} <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<section class="archive-section" id="archive" aria-labelledby="archive-title">
  <div class="wrap">
    <div class="archive-heading">
      <div>
        <p class="section-kicker">{t('The reading table', 'পাঠের টেবিল')}</p>
        <h2 id="archive-title">{t('A closer look at the record.', 'নথিকে দেখুন আরও কাছে থেকে।')}</h2>
      </div>
      <p>{t('Objects, images and documents offer different ways into the past. Each needs context, a source and careful description.', 'বস্তু, ছবি ও নথি—অতীতকে জানার একেকটি পথ। প্রতিটির জন্য প্রয়োজন প্রেক্ষাপট, উৎস ও যত্নশীল পরিচিতি।')}</p>
    </div>

    <div class="exhibit-layout">
      <article class="stamp-exhibit" aria-labelledby="stamp-title">
        <div class="exhibit-label">
          <p>{t('From the supplied collection', 'সরবরাহকৃত সংগ্রহ থেকে')}</p>
          <span aria-hidden="true">↙</span>
        </div>
        <div class="stamp-surface">
          <ArchiveObject lang={lang} compact={true} />
        </div>
        <div class="stamp-description">
          <h3 id="stamp-title">{t('Isa Khan, on a postage stamp', 'ডাকটিকিটে ঈশা খাঁ')}</h3>
          <p>{t('A reference photograph supplied for this website. Full catalogue information and a historical description are pending review.', 'ওয়েবসাইটের জন্য সরবরাহ করা একটি তথ্যসূত্রমূলক আলোকচিত্র। পূর্ণাঙ্গ তালিকাভুক্তি ও ঐতিহাসিক বিবরণ পর্যালোচনাধীন।')}</p>
        </div>
      </article>

      <div class="record-stack">
        <article class="pending-record"><p class="record-status">{t('Published source material', 'প্রকাশিত উৎস উপকরণ')}</p><h3>{t('Heritage photographs & references', 'ঐতিহ্যের আলোকচিত্র ও তথ্যসূত্র')}</h3><p>{t('Place photographs and reading references shared by the foundation’s channel.', 'ফাউন্ডেশনের চ্যানেলে প্রকাশিত স্থান-আলোকচিত্র ও পাঠসূত্র।')}</p>{heritageReferences.map(item => <a class="text-link reference-link" href={item.source}>{item.title[lang]} ↗</a>)}</article>
        <article class="pending-record"><p class="record-status">{t('Foundation publications', 'ফাউন্ডেশনের প্রকাশনা')}</p><h3>{t('Books that carry the conversation', 'বইয়ে আলোচনার বিস্তার')}</h3><p>{t('The channel presents writing on Isa Khan and his descendants, society and democracy.', 'ঈশা খাঁ ও তাঁর বংশধর, সমাজ ও গণতন্ত্রবিষয়ক রচনা চ্যানেলে তুলে ধরা হয়েছে।')}</p><a class="text-link" href="#publications">{t('Explore the publications', 'প্রকাশনা দেখুন')} ↗</a></article>
      </div>
    </div>
    <p class="archive-note">{t('Photographs and captions link to the foundation’s public posts. Institutional document copies remain under review.', 'আলোকচিত্র ও ক্যাপশনের সঙ্গে ফাউন্ডেশনের প্রকাশ্য পোস্টের সংযোগ রয়েছে। প্রাতিষ্ঠানিক নথির অনুলিপি পর্যালোচনাধীন।')}</p>
  </div>
</section>

<section class="activities-section" id="activities" aria-labelledby="activities-title">
  <div class="wrap activities-layout">
    <div class="activities-intro">
      <p class="section-kicker">{t('Purpose in the present', 'বর্তমানের প্রতি দায়')}</p>
      <h2 id="activities-title">{t('Heritage belongs in everyday life.', 'প্রতিদিনের জীবনেও থাকুক ঐতিহ্য।')}</h2>
      <p>{t('The foundation’s areas of interest join historical awareness with a commitment to people and community.', 'ইতিহাসের সচেতনতাকে মানুষ ও সমাজের প্রতি অঙ্গীকারের সঙ্গে যুক্ত করে ফাউন্ডেশনের আগ্রহের ক্ষেত্রগুলো।')}</p>
      <p class="activities-note">{t('Visits, commemorations, publications and public dialogue are documented in the foundation’s own posts.', 'ফাউন্ডেশনের নিজস্ব পোস্টে পরিদর্শন, স্মরণ অনুষ্ঠান, প্রকাশনা ও জনপরিসরের আলোচনার তথ্য রয়েছে।')}</p>
    </div>
    <ActivityJournal lang={lang} />
  </div>
</section>

<Publications lang={lang} />
<section class="documents-section" id="documents" aria-labelledby="documents-title">
  <div class="wrap documents-layout">
    <div class="documents-intro">
      <p class="section-kicker">{t('Institutional record', 'প্রাতিষ্ঠানিক নথি')}</p>
      <h2 id="documents-title">{t('Documents, with context.', 'প্রেক্ষাপটসহ নথিপত্র।')}</h2>
      <p>{t('Public copies are pending review. Publication notes will accompany any document made available here.', 'প্রকাশ্য অনুলিপি পর্যালোচনাধীন। এখানে প্রকাশিত প্রতিটি নথির সঙ্গে প্রাসঙ্গিক তথ্য দেওয়া হবে।')}</p>
    </div>
    <div class="document-list">
      <details>
        <summary><span>{t('Constitution', 'গঠনতন্ত্র')}</span><span class="details-symbol" aria-hidden="true">+</span></summary>
        <div class="document-body">
          <p class="document-status">{t('Public copy pending review', 'প্রকাশ্য অনুলিপি পর্যালোচনাধীন')}</p>
          <p>{t('A reviewed public copy of the foundation’s constitution is not yet available on this website. The publication record will include the document title, language and relevant version information.', 'ফাউন্ডেশনের গঠনতন্ত্রের পর্যালোচিত প্রকাশ্য অনুলিপি এখনও এই ওয়েবসাইটে নেই। প্রকাশের সময় নথির শিরোনাম, ভাষা ও প্রযোজ্য সংস্করণের তথ্য দেওয়া হবে।')}</p>
        </div>
      </details>
      <details>
        <summary><span>{t('Registration', 'নিবন্ধন')}</span><span class="details-symbol" aria-hidden="true">+</span></summary>
        <div class="document-body">
          <p class="document-status">{t('Public copy pending review', 'প্রকাশ্য অনুলিপি পর্যালোচনাধীন')}</p>
          <p>{t('Registration material supplied for reference requires review before a public copy is published. Publication details will be added alongside the reviewed document.', 'তথ্যসূত্র হিসেবে সরবরাহ করা নিবন্ধনসংক্রান্ত উপকরণ প্রকাশের আগে পর্যালোচনা করা প্রয়োজন। পর্যালোচিত নথির সঙ্গে প্রকাশনার বিবরণ যুক্ত করা হবে।')}</p>
        </div>
      </details>
      <a class="text-link document-enquiry" href="#contact">{t('Enquire about a document', 'কোনো নথি সম্পর্কে যোগাযোগ করুন')} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  section { scroll-margin-top: 2rem; }
  p { margin: 0; }
  .reading-room { background: var(--deep); color: var(--ivory); }
  .reading-room .wrap { padding-top: 2rem; padding-bottom: 0; }
  .room-heading { display: flex; justify-content: space-between; gap: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid #648075; font-size: .9rem; }
  .room-heading p:first-child { color: #e2b390; }
  .opening { position: relative; padding: 4rem 0 3.75rem; }
  .opening-label { font-size: 1rem; margin-bottom: 1.5rem; }
  h1 { font-size: clamp(3.7rem, 7.8vw, 7.6rem); max-width: 1050px; line-height: 1.03; letter-spacing: -.055em; margin: 0 0 2rem; font-weight: 400; text-wrap: balance; }
  .opening-bottom { display: flex; align-items: flex-start; gap: 2rem; max-width: 690px; margin-left: auto; }
  .opening-bottom p { max-width: 590px; font-size: 1.15rem; line-height: 1.75; color: #e2e6d9; }
  .opening-mark { font-family: 'Bengali Serif', var(--serif); color: #dbac88; font-size: 3.8rem; line-height: 1; }
  .subject-index { border-top: 1px solid #648075; padding: 1.3rem 0 0; }
  .index-title { font-size: .9rem; color: #d7decf; margin-bottom: 1rem; }
  .subject-index ol { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .subject-index li { min-width: 0; border-top: 1px solid #648075; }
  .subject-index li:nth-child(3n + 2) { border-left: 1px solid #648075; border-right: 1px solid #648075; }
  .subject-index a { display: flex; align-items: center; gap: .9rem; color: var(--ivory); padding: 1.3rem 1rem; min-height: 5rem; text-decoration: none; font-size: 1rem; line-height: 1.5; transition: background-color .15s; }
  .subject-index a:hover { background: #224c40; }
  .subject-index a:focus-visible { outline: 3px solid #efc5a4; outline-offset: -4px; }
  .subject-number { font-size: .78rem; color: #dec1a6; }
  .subject-arrow { margin-left: auto; font-size: 1.35rem; color: #e2b390; }
  .section-kicker { color: var(--copper); font-size: .95rem; margin-bottom: 1.5rem; }
  h2 { font-weight: 400; font-size: clamp(2.3rem, 3.7vw, 3.65rem); line-height: 1.15; letter-spacing: -.035em; margin: 0 0 1.5rem; text-wrap: balance; }
  h3 { font-family: var(--serif); font-weight: 400; font-size: 1.65rem; line-height: 1.3; margin: 0 0 1rem; }
  .foundation-section .wrap { padding-top: 6rem; padding-bottom: 6rem; }
  .foundation-layout { display: grid; grid-template-columns: 1fr 2fr; gap: 6rem; }
  .section-sidebar { max-width: 265px; }
  .foundation-name { font-family: var(--serif); font-size: 1.5rem; margin-bottom: .55rem; }
  .foundation-alias { color: var(--muted); font-size: .92rem; line-height: 1.65; }
  .foundation-statement { max-width: 760px; }
  .foundation-statement > p { font-size: 1.06rem; line-height: 1.85; margin-bottom: 1.2rem; }
  .foundation-statement .text-link { display: inline-block; margin-top: .8rem; }
  .archive-section { background: var(--paper); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .archive-section .wrap { padding-top: 5rem; padding-bottom: 2rem; }
  .archive-heading { display: grid; grid-template-columns: 1.4fr 1fr; gap: 5rem; align-items: end; margin-bottom: 2.7rem; }
  .archive-heading h2 { margin-bottom: 0; }
  .archive-heading > p { line-height: 1.8; max-width: 440px; padding-bottom: .3rem; }
  .exhibit-layout { display: grid; grid-template-columns: 1.15fr 1fr; gap: 2.5rem; align-items: start; }
  .stamp-exhibit { background: var(--ivory); border: 1px solid #bdbfae; padding: 1.3rem 1.75rem 1.75rem; }
  .exhibit-label { display: flex; justify-content: space-between; gap: 1rem; align-items: center; border-bottom: 1px solid var(--line); padding-bottom: 1rem; font-size: .83rem; color: var(--muted); }
  .exhibit-label span { font-size: 1.35rem; color: var(--copper); }
  .stamp-surface { max-width: 280px; margin: 2.5rem auto 2.1rem; }
  .stamp-description { border-top: 1px solid var(--line); padding-top: 1.5rem; }
  .stamp-description h3 { font-size: 1.65rem; }
  .stamp-description p { color: var(--muted); font-size: .94rem; line-height: 1.75; max-width: 440px; }
  .record-stack { border-top: 1px solid #b2b9a6; }
  .pending-record { padding: 1.6rem 0 2rem; border-bottom: 1px solid #b2b9a6; }
  .record-status { color: var(--copper); font-size: .85rem; margin-bottom: 1.4rem; line-height: 1.6; }
  .record-status span { margin-right: .25rem; }
  .pending-record h3 { font-size: 1.8rem; }
  .pending-record > p:not(.record-status) { max-width: 430px; color: var(--muted); font-size: 1rem; line-height: 1.75; }
  .pending-record .text-link { display: inline-block; margin-top: 1.5rem; }
  .archive-note { font-size: .85rem; line-height: 1.65; color: var(--muted); margin-top: 2rem; padding-top: 1.4rem; border-top: 1px solid #b2b9a6; }
  .activities-section { background: var(--green); color: var(--ivory); }
  .activities-layout { padding-top: 5.5rem; padding-bottom: 5.5rem; }
  .activities-section .section-kicker { color: #e2b390; }
  .activities-intro h2 { font-size: clamp(2.4rem, 3.5vw, 3.3rem); }
  .activities-intro > p:not(.section-kicker) { line-height: 1.8; color: #e2e6d9; }
  .activities-intro .activities-note { font-size: .87rem; margin-top: 2rem; max-width: 340px; }
  .documents-layout { display: grid; grid-template-columns: 1fr 1.15fr; gap: 7rem; padding-top: 5.5rem; padding-bottom: 5.5rem; }
  .documents-intro > p:last-child { color: var(--muted); line-height: 1.8; max-width: 380px; }
  .document-list { border-top: 1px solid #aeb7a6; }
  details { border-bottom: 1px solid #aeb7a6; }
  summary { display: flex; justify-content: space-between; gap: 1rem; cursor: pointer; padding: 1.45rem .1rem; font-size: 1.25rem; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--copper); }
  summary:focus-visible { outline: 3px solid var(--copper); outline-offset: 3px; }
  .details-symbol { font-family: var(--sans); color: var(--copper); font-size: 1.4rem; line-height: 1; }
  details[open] .details-symbol { transform: rotate(45deg); }
  .document-body { padding: 0 1.3rem 1.7rem .1rem; color: var(--muted); font-size: .97rem; line-height: 1.8; }
  .document-body .document-status { color: var(--copper); font-size: .85rem; margin-bottom: .8rem; }
  .document-enquiry { display: inline-block; margin-top: 1.7rem; }
  :global(html[lang='bn']) .reading-room h1 { font-size: clamp(3.4rem, 6.6vw, 6rem); line-height: 1.3; letter-spacing: -.035em; }
  :global(html[lang='bn']) .subject-index a { line-height: 1.7; }
  :global(html[lang='bn']) h2 { line-height: 1.35; }
  @media (max-width: 1000px) {
    .foundation-layout, .archive-heading { gap: 3rem; }
    .activities-layout, .documents-layout { gap: 3rem; }
    .exhibit-layout { gap: 1.7rem; }
    .subject-index a { padding-right: .7rem; padding-left: .7rem; gap: .6rem; }
  }
  @media (max-width: 700px) {
    .reading-room .wrap { padding-top: 1.2rem; }
    .room-heading { display: block; font-size: .85rem; }
    .room-heading p + p { margin-top: .4rem; color: #d7decf; }
    .opening { padding: 2.8rem 0 2.5rem; }

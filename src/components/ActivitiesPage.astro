---
import type { Lang } from '../data/concepts';
import ActivityCard from './ActivityCard.astro';
import { activities, channelUrl } from '../data/foundation';
import { earlierIds } from '../data/activity-details';
import { pathFor } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = (en: string, bn: string) => lang === 'bn' ? bn : en;
const recent = activities.filter(entry => !earlierIds.includes(entry.id)).sort((a,b) => Date.parse(b.publishedAt) - Date.parse(a.publishedAt));
const earlier = activities.filter(entry => earlierIds.includes(entry.id));
---
<div class="site-wrap section-space">
  <section aria-labelledby="recent-records"><div class="section-heading-public"><h2 id="recent-records">{t('Visits, discussions and publications', 'পরিদর্শন, আলোচনা ও প্রকাশনা')}</h2><a href="#earlier-records">{t('Earlier records', 'আগের আয়োজন')}</a></div><p class="source-note" style="border:0;padding:0;margin-bottom:2rem">{t('Cards show when the foundation published each post. Open a record for the event date where known, the exact publication time in Dhaka and the original source.', 'এখানে ফাউন্ডেশনের পোস্ট প্রকাশের তারিখ দেখানো হয়েছে। জানা থাকলে অনুষ্ঠানের তারিখ, ঢাকা সময়ে নির্দিষ্ট প্রকাশকাল ও মূল উৎস দেখতে বিবরণ খুলুন।')}</p><div class="activity-list">{recent.map(entry => <ActivityCard lang={lang} entry={entry} />)}</div></section>
  <section aria-labelledby="earlier-records" style="margin-top:3rem"><div class="section-heading-public"><h2 id="earlier-records">{t('From the earlier record', 'আগের আয়োজনের বিবরণ')}</h2></div><p class="source-note" style="border:0;padding:0;margin-bottom:2rem">{t('Retrospective posts preserve the foundation’s account of programmes from 2005, 2007, 2009 and 2012.', 'স্মৃতিচারণমূলক পোস্টে ২০০৫, ২০০৭, ২০০৯ ও ২০১২ সালের আয়োজন সম্পর্কে ফাউন্ডেশনের বিবরণ রয়েছে।')}</p><div class="activity-list">{earlier.map(entry => <ActivityCard lang={lang} entry={entry} />)}</div></section>
  <p style="margin-top:2rem"><a class="text-link" href={channelUrl}>{t('Browse the original channel posts', 'চ্যানেলের মূল পোস্টগুলো দেখুন')}</a> <span aria-hidden="true"> / </span> <a class="text-link" href={pathFor(lang, 'sources')}>{t('Sources and date method', 'তথ্যসূত্র ও তারিখের পদ্ধতি')}</a></p>
</div>

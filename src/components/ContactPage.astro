---
import type { Lang } from '../data/concepts';
import { pathFor } from '../data/site';
import { channelUrl } from '../data/foundation';
const { lang } = Astro.props as { lang: Lang };
const t = (en: string, bn: string) => lang === 'bn' ? bn : en;
---
<div class="contact-layout site-wrap"><section class="contact-primary" aria-labelledby="contact-details"><h2 id="contact-details">{t('Email or telephone', 'ইমেইল বা টেলিফোন')}</h2><a href="mailto:isakhanfoundation@gmail.com" lang="en">isakhanfoundation@gmail.com</a><a href="tel:+8801819514684" lang="en">+880 1819 514684</a><p>{t('Use these foundation contact channels for enquiries about activities, historical material, publications and institutional documents.', 'কার্যক্রম, ঐতিহাসিক উপকরণ, প্রকাশনা ও প্রাতিষ্ঠানিক নথি সম্পর্কে জানতে ফাউন্ডেশনের এই যোগাযোগমাধ্যমগুলো ব্যবহার করুন।')}</p><p><a class="text-link" href={channelUrl} style="font-size:.9rem">{t('Visit ISA KHAN FOUNDATION TV on YouTube', 'ইউটিউবে ISA KHAN FOUNDATION TV দেখুন')}</a></p></section>
<section aria-labelledby="enquiry-topics"><h2 id="enquiry-topics">{t('What to include in your enquiry', 'অনুসন্ধানে যে তথ্য দেবেন')}</h2><dl class="contact-topics"><div><dt>{t('Activities and participation', 'কার্যক্রম ও অংশগ্রহণ')}</dt><dd>{t('Name the programme or activity you are asking about. If you are referring to a website record, include its page address.', 'কোন কর্মসূচি বা কার্যক্রম সম্পর্কে জানতে চান তা লিখুন। ওয়েবসাইটের কোনো বিবরণের প্রসঙ্গ হলে পৃষ্ঠার ঠিকানা দিন।')}</dd></div><div><dt>{t('Books and documents', 'গ্রন্থ ও নথি')}</dt><dd>{t('Give the title or document name and explain whether you need bibliographic information, a reading copy or an institutional verification.', 'শিরোনাম বা নথির নাম দিন। গ্রন্থতথ্য, পড়ার অনুলিপি নাকি প্রাতিষ্ঠানিক যাচাই প্রয়োজন তা জানান।')}</dd></div><div><dt>{t('Archive contributions and corrections', 'সংগ্রহে উপকরণ দেওয়া ও তথ্য সংশোধন')}</dt><dd>{t('Include the source, creator, date and place where known. For a correction, identify the page and the evidence supporting the change.', 'জানা থাকলে উৎস, স্রষ্টা, তারিখ ও স্থান দিন। সংশোধনের ক্ষেত্রে পৃষ্ঠা ও পরিবর্তনের সমর্থনে প্রমাণ উল্লেখ করুন।')}</dd></div><div><dt>{t('Permission to reproduce material', 'উপকরণ পুনর্ব্যবহার')}</dt><dd>{t('Identify the photograph, document or text and describe the intended use. See the content-use page for source credits.', 'ছবি, নথি বা লেখা চিহ্নিত করে ব্যবহারের উদ্দেশ্য জানান। উৎসের স্বীকৃতির জন্য উপকরণের ব্যবহারবিষয়ক পৃষ্ঠা দেখুন।')} <a href={pathFor(lang, 'content-use')}>{t('Content use and credits', 'উপকরণের ব্যবহার ও স্বীকৃতি')}</a></dd></div></dl></section></div>

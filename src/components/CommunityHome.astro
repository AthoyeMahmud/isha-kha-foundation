---
import ArchiveObject from './ArchiveObject.astro';
import ActivityJournal from './ActivityJournal.astro';
import Publications from './Publications.astro';
import { foundationProfile, heritageReferences } from '../data/foundation';

interface Props {
  lang: 'en' | 'bn';
}

const { lang } = Astro.props;
const t = (en: string, bn: string) => lang === 'bn' ? bn : en;
---

<div class="community-home">
  <section class="community-hero wrap" aria-labelledby="community-title">
    <p class="eyebrow hero-kicker"><span></span>{t('Heritage. Humanity. A shared future.', 'ঐতিহ্য। মানবতা। একসঙ্গে ভবিষ্যৎ।')}<span></span></p>
    <h1 id="community-title" lang="bn">শিকড়ে ইতিহাস,<br />পাশে মানুষ।</h1>
    <p class="hero-translation">{t('Rooted in history. Here for people.', 'স্মৃতি, সংস্কৃতি ও মানুষের জন্য একটি ফাউন্ডেশন।')}</p>
    <p class="hero-description">{t('Honouring the legacy of Isa Khan through Bengal’s history, cultural life and the spirit of social welfare.', 'বাংলার ইতিহাস, সাংস্কৃতিক চর্চা ও সমাজকল্যাণের ভাবনায় ঈশা খাঁর উত্তরাধিকারকে ধারণ করা।')}</p>
    <div class="hero-actions">
      <a class="button" href="#activities">{t('Explore our purpose', 'আমাদের উদ্দেশ্য জানুন')}<span aria-hidden="true">↗</span></a>
      <a class="text-link" href="#heritage">{t('Meet our heritage', 'ঐতিহ্যের পরিচয়')}<span aria-hidden="true">→</span></a>
    </div>
    <div class="hero-footnote"><span aria-hidden="true">✳</span><p>{t('The past gives us perspective. People give us purpose.', 'অতীত দেয় দৃষ্টিভঙ্গি। মানুষ দেয় পথচলার অর্থ।')}</p></div>
  </section>

  <section id="foundation" class="foundation-strip" aria-labelledby="foundation-title">
    <div class="wrap foundation-grid">
      <p class="eyebrow">{t('The foundation', 'ফাউন্ডেশন')}</p>
      <h2 id="foundation-title">{t('A living connection between heritage and humanity.', 'ঐতিহ্য ও মানবতার এক জীবন্ত সংযোগ।')}</h2>
      <p>{foundationProfile[lang]}<br /><a class="text-link" href="https://www.youtube.com/post/Ugkx91aHMM9mZmUleuVvKeVnxBQ0kQVII_ZM">{t('Foundation profile on YouTube', 'ইউটিউবে ফাউন্ডেশনের পরিচিতি')} ↗</a></p>
    </div>
  </section>

  <section id="activities" class="activity-band" aria-labelledby="activity-title">
    <div class="wrap">
      <div class="activity-heading">
        <div>
          <p class="eyebrow">{t('Activities in the public record', 'প্রকাশ্য নথিতে কার্যক্রম')}</p>
          <h2 id="activity-title">{t('A legacy finds meaning in people.', 'মানুষের মাঝেই উত্তরাধিকারের অর্থ।')}</h2>
        </div>
        <p>{t('Heritage visits, discussions, publications and public observances connect historical memory with people today.', 'ঐতিহ্য পরিদর্শন, আলোচনা, প্রকাশনা ও জনপরিসরের আয়োজন ইতিহাসের স্মৃতিকে আজকের মানুষের সঙ্গে যুক্ত করে।')}</p>
      </div>
      <ActivityJournal lang={lang} />
    </div>
  </section>

  <section id="heritage" class="heritage-section wrap" aria-labelledby="heritage-title">
    <div class="heritage-copy">
      <p class="eyebrow">{t('The legacy we carry', 'যে উত্তরাধিকার আমরা ধারণ করি')}</p>
      <h2 id="heritage-title">{t('To know our roots. To imagine what follows.', 'শিকড়কে জানা। আগামীকে ভাবা।')}</h2>
      <p>{t('Isa Khan’s place in Bengal’s historical memory is the starting point. The foundation connects that inheritance with an interest in history, cultural expression and community life today.', 'বাংলার ঐতিহাসিক স্মৃতিতে ঈশা খাঁর অবস্থান থেকেই এই যাত্রার সূচনা। ফাউন্ডেশন সেই উত্তরাধিকারকে আজকের ইতিহাসচর্চা, সাংস্কৃতিক প্রকাশ ও সমাজজীবনের সঙ্গে যুক্ত করে।')}</p>
      <a class="text-link" href="#archive">{t('Look into the archive', 'সংগ্রহশালায় দেখুন')}<span aria-hidden="true">→</span></a>
      <p class="heritage-aside">{t('Memory is something we hold together.', 'স্মৃতি আমাদের সম্মিলিত উত্তরাধিকার।')}</p>
    </div>
    <div class="heritage-object">
      <p class="eyebrow">{t('An object, a connection', 'একটি নিদর্শন, একটি সংযোগ')}</p>
      <ArchiveObject lang={lang} compact />
    </div>
  </section>

  <section id="archive" class="archive-section" aria-labelledby="archive-title">
    <div class="wrap archive-grid">
      <div>
        <p class="eyebrow">{t('The archive', 'সংগ্রহশালা')}</p>
        <h2 id="archive-title">{t('Small traces.', 'ছোট ছোট চিহ্ন।')}<br />{t('Shared memory.', 'সম্মিলিত স্মৃতি।')}</h2>
        <p>{t('A considered home for material connected to Isa Khan and the foundation. Public items will carry context and a clear source.', 'ঈশা খাঁ ও ফাউন্ডেশনের সঙ্গে সংশ্লিষ্ট উপকরণের একটি যত্নশীল ঠিকানা। প্রকাশ্য প্রতিটি উপকরণের সঙ্গে থাকবে প্রেক্ষাপট ও স্পষ্ট উৎস।')}</p>
      </div>
      <div class="archive-inventory">
        <div class="inventory-heading"><span>{t('Collection guide', 'সংগ্রহের পরিচিতি')}</span><span>{t('Preview', 'প্রাক্‌দর্শন')}</span></div>
        <div class="inventory-row"><h3>{t('Commemorative stamp', 'স্মারক ডাকটিকিট')}</h3><p>{t('Shown above', 'ওপরে প্রদর্শিত')}</p><span aria-hidden="true">↗</span></div>
        {heritageReferences.map(item => <div class="inventory-row"><h3><a href={item.source}>{item.title[lang]}</a></h3><p>{t('Foundation channel', 'ফাউন্ডেশনের চ্যানেল')}</p><span aria-hidden="true">↗</span></div>)}
        <p class="inventory-note">{t('Source photographs and reading references are available through the original posts.', 'মূল পোস্টে উৎস আলোকচিত্র ও পাঠসূত্র পাওয়া যাবে।')}</p>
      </div>
    </div>
  </section>

  <Publications lang={lang} />
  <section id="documents" class="documents-section wrap" aria-labelledby="documents-title">
    <div class="documents-heading">
      <div><p class="eyebrow">{t('Documents', 'নথিপত্র')}</p><h2 id="documents-title">{t('Clarity builds trust.', 'স্বচ্ছতা আস্থা তৈরি করে।')}</h2></div>
      <p>{t('A dedicated place for approved public information about the foundation.', 'ফাউন্ডেশন সম্পর্কে অনুমোদিত প্রকাশ্য তথ্যের নির্দিষ্ট স্থান।')}</p>
    </div>
    <details>
      <summary><span>{t('Foundation information & public documents', 'ফাউন্ডেশনের পরিচিতি ও প্রকাশ্য নথি')}</span><span class="details-status">{t('Pending review', 'পর্যালোচনাধীন')}</span><span class="details-symbol" aria-hidden="true">+</span></summary>
      <div class="details-content"><p>{t('Public copies of the foundation’s information and documents will appear here after review and approval. Downloads are not available in this homepage concept.', 'পর্যালোচনা ও অনুমোদনের পর ফাউন্ডেশনের তথ্য ও নথির প্রকাশ্য অনুলিপি এখানে যুক্ত হবে। এই হোমপেজ ধারণায় ডাউনলোড উপলব্ধ নয়।')}</p></div>
    </details>
  </section>
</div>

<style>
  .community-home { background: var(--ivory); }
  .eyebrow { margin: 0 0 1.5rem; font-size: .7rem; font-weight: 650; letter-spacing: .02em; line-height: 1.7; }
  .community-hero { padding-top: 5.2rem; padding-bottom: 0; text-align: center; }
  .hero-kicker { margin-inline: auto; display: flex; justify-content: center; align-items: center; gap: 1.3rem; color: var(--copper); }
  .hero-kicker span { width: 3.1rem; height: 1px; background: var(--copper); }
  h1 { margin: 2.1rem auto 1.4rem; font-size: clamp(3.5rem, 7.5vw, 7rem); font-weight: 500; line-height: 1.2; letter-spacing: -.035em; }
  .hero-translation { margin: 0; font-family: var(--serif); font-size: clamp(1.3rem, 2.4vw, 2.05rem); line-height: 1.4; }
  .hero-description { max-width: 39rem; margin: 1.4rem auto 1.9rem; font-size: .95rem; line-height: 1.8; color: var(--muted); }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 1.9rem; }
  .hero-actions .button, .hero-actions .text-link { display: inline-flex; align-items: center; gap: 1.9rem; }
  .hero-footnote { margin-top: 4rem; border-top: 1px solid var(--line); min-height: 5rem; display: flex; align-items: center; justify-content: center; gap: .9rem; color: var(--muted); }
  .hero-footnote > span { color: var(--copper); font-size: 1.4rem; }
  .hero-footnote p { font-family: var(--serif); font-style: italic; font-size: 1rem; }
  .foundation-strip { border-top: 1px solid var(--line); }
  .foundation-grid { display: grid; grid-template-columns: .65fr 1.55fr 1fr; gap: 3rem; padding-top: 3rem; padding-bottom: 3.3rem; align-items: start; }
  .foundation-grid .eyebrow { padding-top: .45rem; color: var(--copper); }
  .foundation-grid h2 { font-size: clamp(1.8rem, 2.8vw, 2.6rem); font-weight: 400; line-height: 1.22; margin: 0; letter-spacing: -.03em; }
  .foundation-grid > p:last-child { margin: .2rem 0 0; color: var(--muted); font-size: .88rem; line-height: 1.8; }
  .activity-band { background: var(--deep); color: var(--ivory); }
  .activity-band > .wrap { padding-top: 5.3rem; padding-bottom: 4.5rem; }
  .activity-heading { display: grid; grid-template-columns: 1.7fr 1fr; align-items: end; gap: 6rem; }
  .activity-heading .eyebrow { color: #cfac8e; }
  .activity-heading h2 { font-size: clamp(2.5rem, 4.2vw, 4rem); line-height: 1.1; font-weight: 400; letter-spacing: -.035em; max-width: 36rem; margin: 0; }
  .activity-heading > p { font-size: .91rem; line-height: 1.85; color: #d0dbd0; margin: 0 0 .15rem; max-width: 25rem; }
  .heritage-section { display: grid; grid-template-columns: 1.2fr 1fr; align-items: center; gap: 8vw; padding-top: 6.5rem; padding-bottom: 6.5rem; }
  .heritage-copy > .eyebrow { color: var(--copper); }
  .heritage-copy h2 { font-size: clamp(2.7rem, 4.1vw, 3.8rem); font-weight: 400; line-height: 1.15; letter-spacing: -.035em; margin: 0 0 1.6rem; }
  .heritage-copy > p:not(.eyebrow):not(.heritage-aside) { font-size: .94rem; line-height: 1.9; color: var(--muted); max-width: 34rem; margin: 0 0 1.5rem; }
  .heritage-copy .text-link { display: inline-flex; gap: 1.5rem; align-items: center; }
  .heritage-aside { border-left: 1px solid var(--copper); padding-left: 1.2rem; color: var(--copper); font-family: var(--serif); font-style: italic; font-size: 1.3rem; line-height: 1.5; margin: 3.3rem 0 0; max-width: 21rem; }
  .heritage-object { background: var(--paper); padding: 2rem; transform: rotate(2deg); }
  .heritage-object > .eyebrow { font-size: .6rem; text-align: center; margin-bottom: 1.5rem; }
  .heritage-object :global(figure) { transform: rotate(-2deg); }
  .archive-section { background: var(--paper); }
  .archive-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 8vw; padding-top: 4.5rem; padding-bottom: 4.5rem; align-items: start; }
  .archive-grid > div > .eyebrow { color: var(--copper); }
  .archive-grid h2 { font-size: clamp(2.5rem, 3.9vw, 3.5rem); font-weight: 400; line-height: 1.12; letter-spacing: -.035em; margin: 0 0 1.4rem; }
  .archive-grid > div > p:last-child { font-size: .9rem; color: var(--muted); line-height: 1.8; max-width: 26rem; margin: 0; }
  .archive-inventory { margin-top: .3rem; }
  .inventory-heading { display: flex; justify-content: space-between; gap: 1rem; font-size: .63rem; letter-spacing: .02em; padding-bottom: 1.1rem; color: var(--muted); }
  .inventory-row { display: grid; grid-template-columns: 1.2fr 1fr auto; align-items: center; gap: 1rem; padding: 1.6rem 0; border-top: 1px solid #bdc3b4; }
  .inventory-row h3 { font-family: var(--serif); font-size: 1.25rem; font-weight: 400; line-height: 1.4; margin: 0; }
  .inventory-row p { font-size: .68rem; line-height: 1.6; color: var(--muted); margin: 0; }
  .inventory-row > span { color: var(--copper); }
  .archive-inventory > .inventory-note { border-top: 1px solid #bdc3b4; padding-top: 1.2rem; font-size: .73rem !important; line-height: 1.75 !important; max-width: 35rem !important; }
  .documents-section { padding-top: 4.5rem; padding-bottom: 5rem; }
  .documents-heading { display: flex; justify-content: space-between; gap: 3rem; align-items: end; margin-bottom: 2rem; }
  .documents-heading .eyebrow { color: var(--copper); margin-bottom: 1rem; }
  .documents-heading h2 { font-size: clamp(2.1rem, 3.1vw, 3rem); font-weight: 400; letter-spacing: -.03em; line-height: 1.2; margin: 0; }
  .documents-heading > p { font-size: .88rem; color: var(--muted); line-height: 1.8; max-width: 23rem; margin: 0; }
  details { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  summary { padding: 1.4rem 0; display: flex; gap: 1.3rem; align-items: center; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary > span:first-child { flex: 1; font-size: .92rem; line-height: 1.6; }
  .details-status { font-size: .66rem; color: var(--copper); padding: .3rem .65rem; border: 1px solid var(--line); border-radius: 2rem; }
  .details-symbol { font-size: 1.4rem; font-weight: 300; line-height: 1; min-width: 1rem; text-align: center; }
  details[open] .details-symbol { transform: rotate(45deg); }
  .details-content { padding: 0 0 1.5rem; max-width: 45rem; }
  .details-content p { font-size: .88rem; color: var(--muted); line-height: 1.9; margin: 0; }
  :global(html[lang="bn"]) .community-home h1 { line-height: 1.3; }
  @media (max-width: 900px) {
    .foundation-grid { grid-template-columns: 1fr 1.5fr; gap: 1.5rem 3rem; }
    .foundation-grid > .eyebrow { grid-column: 1 / -1; margin: 0; }
    .activity-heading { gap: 3rem; }
    .heritage-section { gap: 5vw; }
    .heritage-object { padding: 1.4rem; }
    .archive-grid { grid-template-columns: 1fr 1.4fr; gap: 5vw; }
    .inventory-row { grid-template-columns: 1fr auto; gap: .3rem 1rem; }
    .inventory-row p { grid-row: 2; }
    .inventory-row > span { grid-column: 2; grid-row: 1 / 3; }
  }
  @media (max-width: 640px) {
    .community-hero { padding-top: 3.3rem; }
    .hero-kicker { gap: .7rem; font-size: .57rem; letter-spacing: .02em; }
    .hero-kicker span { width: 1.6rem; }
    h1 { font-size: clamp(2.9rem, 12.8vw, 5rem); margin: 1.8rem 0 1rem; }
    .hero-translation { font-size: 1.27rem; }
    .hero-description { font-size: .84rem; margin-top: 1.2rem; }
    .hero-actions { gap: 1.25rem; flex-direction: column; }
    .hero-actions .button { width: 100%; justify-content: space-between; }
    .hero-footnote { margin-top: 2.8rem; min-height: 5.5rem; gap: .7rem; }
    .hero-footnote p { font-size: .87rem; text-align: left; max-width: 17rem; }
    .foundation-grid { display: block; padding-top: 2rem; padding-bottom: 2.5rem; }
    .foundation-grid > .eyebrow { margin-bottom: 1rem; }
    .foundation-grid h2 { font-size: 2rem; margin-bottom: 1.3rem; }
    .foundation-grid > p:last-child { font-size: .85rem; }
    .activity-band > .wrap { padding-top: 3rem; padding-bottom: 2.3rem; }
    .activity-heading { display: block; }
    .activity-heading h2 { font-size: 2.7rem; max-width: 25rem; }
    .activity-heading > p { margin-top: 1.5rem; max-width: none; font-size: .86rem; }
    .heritage-section { grid-template-columns: 1fr; padding-top: 3.5rem; padding-bottom: 3.5rem; gap: 2.5rem; }
    .heritage-copy h2 { font-size: 2.65rem; }
    .heritage-copy > p:not(.eyebrow):not(.heritage-aside) { font-size: .88rem; }
    .heritage-aside { margin-top: 2rem; font-size: 1.2rem; }
    .heritage-object { max-width: 30rem; width: calc(100% - 1rem); margin: 0 auto; padding: 1.6rem; }
    .archive-grid { grid-template-columns: 1fr; gap: 2.3rem; padding-top: 3rem; padding-bottom: 3rem; }
    .archive-grid h2 { font-size: 2.65rem; }
    .archive-grid > div > p:last-child { font-size: .86rem; max-width: none; }
    .inventory-row { padding: 1.25rem 0; }
    .documents-section { padding-top: 3rem; padding-bottom: 3rem; }
    .documents-heading { display: block; margin-bottom: 1.6rem; }
    .documents-heading > p { margin-top: 1.2rem; max-width: none; font-size: .85rem; }
    summary { gap: .75rem; flex-wrap: wrap; }
    summary > span:first-child { flex-basis: calc(100% - 2rem); font-size: .87rem; }
    .details-status { order: 3; font-size: .62rem; }
    .details-content p { font-size: .84rem; }
  }
</style>

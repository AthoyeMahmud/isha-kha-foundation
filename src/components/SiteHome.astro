---
import { Image } from 'astro:assets';
import ArchiveObject from './ArchiveObject.astro';
import ActivityCard from './ActivityCard.astro';
import jangalbari from '../assets/activities/jangalbari-visit.webp';
import discussion from '../assets/activities/history-discussion.webp';
import { activities } from '../data/foundation';
import { pathFor } from '../data/site';
import type { Lang } from '../data/concepts';
const { lang = 'en' } = Astro.props as { lang: Lang };
const t = (en: string, bn: string) => lang === 'bn' ? bn : en;
const latest = [...activities].sort((a,b) => Date.parse(b.publishedAt) - Date.parse(a.publishedAt)).slice(0,4);
---
<section class="home-hero site-wrap" aria-labelledby="home-heading">
  <div><h1 id="home-heading"><span>{t('Isha Kha', 'ঈশা খাঁ')}</span><span>{t('Foundation', 'ফাউন্ডেশন')}</span></h1>
    <p class="institution-subtitle" lang="en">Isa Khan alias Isha Kha Foundation</p>
    <p class="home-introduction">{t('The foundation’s work includes heritage visits, publications, historical discussions and cultural programmes. Education and social welfare are among its founding aims.', 'ফাউন্ডেশনের কার্যক্রমের মধ্যে রয়েছে ঐতিহ্যবাহী স্থান পরিদর্শন, প্রকাশনা, ইতিহাসবিষয়ক আলোচনা ও সাংস্কৃতিক অনুষ্ঠান। শিক্ষা ও সমাজকল্যাণও প্রতিষ্ঠার লক্ষ্যগুলোর অন্তর্ভুক্ত।')}</p>
    <div class="home-actions"><a class="button" href={pathFor(lang, 'foundation')}>{t('About the foundation', 'ফাউন্ডেশন সম্পর্কে')}</a><a class="text-link" href={pathFor(lang, 'activities')}>{t('Explore the activities', 'কার্যক্রম দেখুন')}</a></div>
  </div>
  <div class="stamp-exhibit"><p class="exhibit-label"><span>{t('From the collection', 'সংগ্রহ থেকে')}</span><span lang="bn">ঈশা খাঁ</span></p><ArchiveObject lang={lang} eager /><a class="text-link" href={pathFor(lang, 'archive/isa-khan-stamp')}>{t('Read the object record', 'ডাকটিকিটের পরিচয় পড়ুন')}</a></div>
</section>
<section class="home-foundation site-wrap section-space" aria-labelledby="foundation-overview"><div><h2 id="foundation-overview">{t('History, culture and the foundation’s work', 'ইতিহাস, সংস্কৃতি ও ফাউন্ডেশনের কার্যক্রম')}</h2></div><div><p>{t('Registered on 24 May 2005, Isha Kha Foundation takes its name from Isa Khan. Its public record connects an interest in Bengal’s heritage with visits, discussion, books and commemorative gatherings.', '২০০৫ সালের ২৪ মে নিবন্ধিত ঈশা খাঁ ফাউন্ডেশন ঈশা খাঁর নামে প্রতিষ্ঠিত। প্রকাশ্য সূত্রে বাংলার ঐতিহ্যের প্রতি আগ্রহের সঙ্গে পরিদর্শন, আলোচনা, গ্রন্থ ও স্মরণানুষ্ঠানের সংযোগ রয়েছে।')}</p><a class="text-link" href={pathFor(lang, 'foundation')}>{t('Read about the institution', 'প্রতিষ্ঠানের পরিচয় পড়ুন')}</a></div></section>
<section class="paper-section section-space" aria-labelledby="field-records"><div class="site-wrap"><div class="section-heading-public"><h2 id="field-records">{t('Visits and historical discussion', 'পরিদর্শন ও ইতিহাসবিষয়ক আলোচনা')}</h2><a href={pathFor(lang, 'activities')}>{t('All activities', 'সব কার্যক্রম')}</a></div>
  <div class="photo-pair"><figure class="record-photo"><a href={pathFor(lang, 'activities/jangalbari-visit')}><Image src={jangalbari} widths={[400,700,1000]} sizes="(max-width: 650px) 88vw, 44vw" alt={t('Nasima Sultana Ratna beside a historic building during the visit identified as Jangalbari.', 'জঙ্গলবাড়ী হিসেবে চিহ্নিত সফরে ঐতিহাসিক ভবনের পাশে নাসিমা সুলতানা রত্না।')} format="webp" /></a><figcaption>{t('Jangalbari, Karimganj, Kishoreganj. Source: the foundation’s public visit post.', 'জঙ্গলবাড়ী, করিমগঞ্জ, কিশোরগঞ্জ। উৎস: ফাউন্ডেশনের প্রকাশ্য সফরবিবরণ।')}<h3><a href={pathFor(lang, 'activities/jangalbari-visit')}>{t('A heritage visit to Jangalbari', 'জঙ্গলবাড়ীতে ঐতিহ্য পরিদর্শন')}</a></h3></figcaption></figure>
  <figure class="record-photo"><a href={pathFor(lang, 'activities/isa-khan-commemoration')}><Image src={discussion} widths={[400,700,1000]} sizes="(max-width: 650px) 88vw, 44vw" alt={t('Programme participants holding books at the Isa Khan discussion pictured by the foundation.', 'ফাউন্ডেশনের প্রকাশিত ঈশা খাঁবিষয়ক আলোচনা অনুষ্ঠানে বই হাতে অংশগ্রহণকারীরা।')} format="webp" /></a><figcaption>{t('Isa Khan commemoration, 11 June 2026. Source: ISA KHAN FOUNDATION TV.', 'ঈশা খাঁ স্মরণানুষ্ঠান, ১১ জুন ২০২৬। উৎস: ISA KHAN FOUNDATION TV।')}<h3><a href={pathFor(lang, 'activities/isa-khan-commemoration')}>{t('Remembering Isa Khan through discussion', 'আলোচনায় ঈশা খাঁকে স্মরণ')}</a></h3></figcaption></figure></div>
</div></section>
<section class="site-wrap section-space" aria-labelledby="recent-posts"><div class="section-heading-public"><h2 id="recent-posts">{t('Recently published records', 'সম্প্রতি প্রকাশিত বিবরণ')}</h2><a href={pathFor(lang, 'sources')}>{t('About the sources and dates', 'উৎস ও তারিখ সম্পর্কে')}</a></div><div class="activity-list">{latest.map(entry => <ActivityCard lang={lang} entry={entry} />)}</div></section>
<section class="paper-section section-space"><div class="site-wrap home-records"><div><h2>{t('Explore the heritage', 'ঐতিহ্য সম্পর্কে জানুন')}</h2><p>{t('Read a sourced introduction to Isa Khan and the Bara-Bhuiyans, then explore Sonargaon, Jangalbari and the river landscape of Bhati.', 'তথ্যসূত্রসহ ঈশা খাঁ ও বারো ভুঁইয়ার পরিচিতি পড়ুন। সোনারগাঁও, জঙ্গলবাড়ী ও ভাটির নদীময় ভূপ্রকৃতি সম্পর্কে জানুন।')}</p><ul class="resource-links"><li><a href={pathFor(lang, 'heritage/isa-khan')}>{t('Isa Khan and the Bara-Bhuiyans', 'ঈশা খাঁ ও বারো ভুঁইয়া')}</a></li><li><a href={pathFor(lang, 'heritage/places')}>{t('Places and the river landscape', 'ঐতিহাসিক স্থান ও নদীময় ভূপ্রকৃতি')}</a></li></ul></div>
<div><h2>{t('Read the foundation’s record', 'ফাউন্ডেশনের নথি পড়ুন')}</h2><p>{t('The archive brings together a postage stamp, photographs, books and readable summaries of the institutional papers.', 'সংগ্রহশালায় ডাকটিকিট, আলোকচিত্র, গ্রন্থ এবং প্রাতিষ্ঠানিক কাগজপত্রের পাঠযোগ্য সারসংক্ষেপ একসঙ্গে রয়েছে।')}</p><ul class="resource-links"><li><a href={pathFor(lang, 'publications')}>{t('Books and publications', 'গ্রন্থ ও প্রকাশনা')}</a></li><li><a href={pathFor(lang, 'documents')}>{t('Founding aims and registration', 'প্রতিষ্ঠার লক্ষ্য ও নিবন্ধন')}</a></li><li><a href={pathFor(lang, 'archive')}>{t('Explore the archive', 'সংগ্রহশালা দেখুন')}</a></li></ul></div></div></section>

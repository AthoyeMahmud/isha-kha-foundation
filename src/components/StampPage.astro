---
import type { Lang } from '../data/concepts';
import ArchiveObject from './ArchiveObject.astro';
import { pathFor } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = (en: string, bn: string) => lang === 'bn' ? bn : en;
---
<div class="reading-layout site-wrap"><article class="reading-body"><ArchiveObject lang={lang} eager /><h2>{t('About the object', 'ডাকটিকিটের পরিচয়')}</h2><p>{t('This photograph shows a Bangladesh postage stamp depicting Isa Khan. The visible design combines a portrait representation with Bangla and English lettering, including the name Masnad-e-Ala Isa Khan. The photograph was supplied with the foundation’s reference collection.', 'এই আলোকচিত্রে ঈশা খাঁর প্রতিকৃতিসংবলিত বাংলাদেশের একটি ডাকটিকিট দেখা যায়। নকশায় প্রতিকৃতির সঙ্গে বাংলা ও ইংরেজি লেখা এবং Masnad-e-Ala Isa Khan নামটি রয়েছে। ছবিটি ফাউন্ডেশনের তথ্যসূত্রের সংগ্রহের সঙ্গে সরবরাহ করা হয়েছে।')}</p>
<dl class="record-facts"><div><dt>{t('Object', 'উপকরণ')}</dt><dd>{t('Postage stamp, photographed', 'ডাকটিকিটের আলোকচিত্র')}</dd></div><div><dt>{t('Subject', 'বিষয়')}</dt><dd>{t('Isa Khan', 'ঈশা খাঁ')}</dd></div><div><dt>{t('Source', 'উৎস')}</dt><dd>{t('Supplied foundation collection', 'ফাউন্ডেশনের সরবরাহকৃত সংগ্রহ')}</dd></div><div><dt>{t('Visible languages', 'দৃশ্যমান ভাষা')}</dt><dd>{t('Bangla and English', 'বাংলা ও ইংরেজি')}</dd></div></dl>
<h2>{t('A commemorative representation', 'স্মারক উপস্থাপন')}</h2><p>{t('The stamp is a later commemorative image. It is used here as an archival object connected with the remembrance of Isa Khan, rather than as a portrait made during his lifetime. The photograph’s paper, border and visible condition are retained in the display.', 'ডাকটিকিটটি পরবর্তী কালের স্মারকচিত্র। ঈশা খাঁকে স্মরণের সঙ্গে যুক্ত একটি সংগ্রহযোগ্য উপকরণ হিসেবে এখানে দেখানো হয়েছে; তাঁর জীবদ্দশায় আঁকা প্রতিকৃতি হিসেবে নয়। প্রদর্শনে ছবির কাগজ, প্রান্ত ও দৃশ্যমান অবস্থা অক্ষুণ্ন রয়েছে।')}</p>
<h2>{t('Historical reading', 'ঐতিহাসিক পাঠ')}</h2><p>{t('For a short historical introduction, read the article on Isa Khan and the Bara-Bhuiyans. For an enquiry about reproducing this photograph, identify this object record when contacting the foundation.', 'সংক্ষিপ্ত ঐতিহাসিক পরিচিতির জন্য ঈশা খাঁ ও বারো ভুঁইয়াবিষয়ক নিবন্ধ পড়ুন। ছবিটি পুনর্ব্যবহার সম্পর্কে জানতে ফাউন্ডেশনে যোগাযোগের সময় এই পরিচিতির লিংক দিন।')}</p><a class="text-link" href={pathFor(lang, 'heritage/isa-khan')}>{t('Read about Isa Khan', 'ঈশা খাঁ সম্পর্কে পড়ুন')}</a></article>
<aside class="reading-aside"><h2>{t('Explore the collection', 'সংগ্রহ দেখুন')}</h2><ul><li><a href={pathFor(lang, 'archive')}>{t('Archive overview', 'সংগ্রহশালার পরিচয়')}</a></li><li><a href={pathFor(lang, 'publications')}>{t('Publications', 'প্রকাশনা')}</a></li><li><a href={pathFor(lang, 'content-use')}>{t('Content use and credits', 'উপকরণের ব্যবহার ও স্বীকৃতি')}</a></li><li><a href={pathFor(lang, 'contact')}>{t('Contact about this object', 'এই উপকরণ সম্পর্কে যোগাযোগ')}</a></li></ul></aside></div>

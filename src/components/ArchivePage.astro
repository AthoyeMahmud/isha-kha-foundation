---
import type { Lang } from '../data/concepts';
import ArchiveObject from './ArchiveObject.astro';
import { pathFor } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = (en: string, bn: string) => lang === 'bn' ? bn : en;
---
<div class="archive-grid site-wrap"><article class="archive-feature"><ArchiveObject lang={lang} /><h2>{t('Isa Khan on a postage stamp', 'ডাকটিকিটে ঈশা খাঁ')}</h2><p>{t('A photographed Bangladesh postage stamp from the supplied collection. The object record identifies what is visible and how the image is used.', 'সরবরাহকৃত সংগ্রহে থাকা বাংলাদেশের ডাকটিকিটের আলোকচিত্র। পরিচিতিতে দৃশ্যমান তথ্য ও ছবির ব্যবহার ব্যাখ্যা করা হয়েছে।')}</p><a class="text-link" href={pathFor(lang, 'archive/isa-khan-stamp')}>{t('Open the object record', 'ডাকটিকিটের পরিচয় খুলুন')}</a></article>
<div class="archive-entries"><article><h2>{t('Heritage visit photographs', 'ঐতিহ্য পরিদর্শনের আলোকচিত্র')}</h2><p>{t('The Jangalbari visit record brings together a site photograph, the foundation’s account and historical reading about the place.', 'জঙ্গলবাড়ী সফরের বিবরণে স্থানের ছবি, ফাউন্ডেশনের ভাষ্য ও ঐতিহাসিক পাঠ একসঙ্গে রয়েছে।')}</p><a class="text-link" href={pathFor(lang, 'activities/jangalbari-visit')}>{t('View the Jangalbari record', 'জঙ্গলবাড়ীর বিবরণ দেখুন')}</a></article>
<article><h2>{t('Discussion and commemoration', 'আলোচনা ও স্মরণানুষ্ঠান')}</h2><p>{t('A photograph of participants holding books accompanies the record of the Isa Khan discussion on 11 June 2026.', '১১ জুন ২০২৬-এর ঈশা খাঁবিষয়ক আলোচনার বিবরণে বই হাতে অংশগ্রহণকারীদের ছবি আছে।')}</p><a class="text-link" href={pathFor(lang, 'activities/isa-khan-commemoration')}>{t('View the programme record', 'অনুষ্ঠানের বিবরণ দেখুন')}</a></article>
<article><h2>{t('Books and printed material', 'গ্রন্থ ও মুদ্রিত উপকরণ')}</h2><p>{t('Publication posts, book presentations and photographed covers document writing on Isa Khan and his descendants, society and democracy.', 'প্রকাশনার পোস্ট, গ্রন্থ উপহার ও প্রচ্ছদের ছবিতে ঈশা খাঁ ও তাঁর বংশধর, সমাজ ও গণতন্ত্রবিষয়ক রচনার পরিচয় রয়েছে।')}</p><a class="text-link" href={pathFor(lang, 'publications')}>{t('Explore the publications', 'প্রকাশনা দেখুন')}</a></article>
<article><h2>{t('The institution’s papers', 'প্রতিষ্ঠানের নথি')}</h2><p>{t('Accessible editorial reading editions explain the founding aims, institutional character and registration record.', 'প্রতিষ্ঠার লক্ষ্য, প্রাতিষ্ঠানিক প্রকৃতি ও নিবন্ধনের তথ্য পাঠযোগ্য সম্পাদকীয় সংস্করণে সাজানো হয়েছে।')}</p><a class="text-link" href={pathFor(lang, 'documents')}>{t('Read the documents', 'নথি পড়ুন')}</a></article>
<article><h2>{t('Earlier activity records', 'আগের কার্যক্রমের বিবরণ')}</h2><p>{t('Retrospective posts preserve accounts of the 2005 heritage rally and gatherings in 2007, 2009 and 2012.', 'স্মৃতিচারণমূলক পোস্টে ২০০৫ সালের ঐতিহ্য রক্ষার র‍্যালি এবং ২০০৭, ২০০৯ ও ২০১২ সালের আয়োজনের বিবরণ আছে।')}</p><a class="text-link" href={pathFor(lang, 'activities') + '#earlier-records'}>{t('Browse earlier records', 'আগের বিবরণগুলো দেখুন')}</a></article></div></div>

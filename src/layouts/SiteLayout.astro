---
import '../styles/global.css';
import '../styles/site.css';
import type { Lang } from '../data/concepts';
import { navigation, pages, pathFor, siteOrigin } from '../data/site';
import { channelUrl } from '../data/foundation';
const { lang = 'en', slug = '', title, description } = Astro.props as { lang: Lang; slug?: string; title: string; description: string };
const t = (en: string, bn: string) => lang === 'bn' ? bn : en;
const other = lang === 'en' ? 'bn' : 'en';
const canonical = siteOrigin + pathFor(lang, slug);
const active = (item: string) => slug === item || slug.startsWith(item + '/') || (item === 'archive' && slug === 'publications');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#173f35" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={siteOrigin + pathFor('en', slug)} />
    <link rel="alternate" hreflang="bn" href={siteOrigin + pathFor('bn', slug)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Isha Kha Foundation" />
    <meta property="og:title" content={title + ' · Isha Kha Foundation'} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'bn' ? 'bn_BD' : 'en_GB'} />
    <meta property="og:image" content={siteOrigin + '/social-preview.png'} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1440" />
    <meta property="og:image:height" content="756" />
    <meta property="og:image:alt" content={t('Isha Kha Foundation homepage with a Bangladesh postage stamp depicting Isa Khan.', 'ঈশা খাঁর প্রতিকৃতিসংবলিত বাংলাদেশের ডাকটিকিটসহ ঈশা খাঁ ফাউন্ডেশনের হোমপেজ।')} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} · Isha Kha Foundation</title>
  </head>
  <body class="public-site">
    <a class="skip-link" href="#main">{t('Skip to content', 'মূল বিষয়বস্তুতে যান')}</a>
    <div class="institution-line"><div class="site-wrap"><span>{t('Bengal’s history, culture and public life', 'বাংলার ইতিহাস, সংস্কৃতি ও জনজীবন')}</span><a href={pathFor(lang, 'publications')}>{t('Publications', 'প্রকাশনা')}</a></div></div>
    <header class="public-header site-wrap">
      <a class="brand" href={pathFor(lang)} aria-label={t('Isha Kha Foundation home', 'ঈশা খাঁ ফাউন্ডেশনের হোমপেজ')}>
        <span class="brand-symbol" aria-hidden="true">ঈ</span>
        <span><strong>{t('Isha Kha Foundation', 'ঈশা খাঁ ফাউন্ডেশন')}</strong><small lang="en">Isa Khan alias Isha Kha Foundation</small></span>
      </a>
      <div class="public-header-right">
        <a class="language-switch" href={pathFor(other, slug)} hreflang={other} lang={other} aria-label={t('Read this page in Bangla', 'এই পৃষ্ঠা ইংরেজিতে পড়ুন')}>{t('বাংলা', 'English')}</a>
        <nav class="primary-navigation" aria-label={t('Main navigation', 'প্রধান নেভিগেশন')}>
          {navigation.map(item => <a href={pathFor(lang, item.slug)} aria-current={active(item.slug) ? 'page' : undefined}>{item.title[lang]}</a>)}
        </nav>
        <details class="mobile-menu"><summary>{t('Menu', 'মেনু')} <span aria-hidden="true">☰</span></summary><nav aria-label={t('Mobile navigation', 'মোবাইল নেভিগেশন')}>
          <a href={pathFor(lang)} aria-current={!slug ? 'page' : undefined}>{t('Home', 'হোমপেজ')}</a>
          {navigation.map(item => <a href={pathFor(lang, item.slug)} aria-current={active(item.slug) ? 'page' : undefined}>{item.title[lang]}</a>)}
          <a href={pathFor(lang, 'publications')}>{t('Publications', 'প্রকাশনা')}</a>
        </nav></details>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="public-footer">
      <div class="site-wrap footer-grid">
        <div class="footer-identity"><p class="footer-name">{t('Isha Kha Foundation', 'ঈশা খাঁ ফাউন্ডেশন')}</p><p lang="en">Isa Khan alias Isha Kha Foundation</p><p>{t('Heritage visits, historical discussion, publications and cultural activities.', 'ঐতিহ্য পরিদর্শন, ইতিহাসবিষয়ক আলোচনা, প্রকাশনা ও সাংস্কৃতিক কার্যক্রম।')}</p><a href={pathFor(lang, 'documents/registration')}>{t('Registered 24 May 2005', 'নিবন্ধিত ২৪ মে ২০০৫')}</a></div>
        <div><h2>{t('Explore', 'দেখুন')}</h2><ul>{navigation.filter(item => item.slug !== 'contact').map(item => <li><a href={pathFor(lang, item.slug)}>{item.title[lang]}</a></li>)}<li><a href={pathFor(lang, 'publications')}>{t('Publications', 'প্রকাশনা')}</a></li></ul></div>
        <div><h2>{t('Get in touch', 'যোগাযোগ করুন')}</h2><a href="mailto:isakhanfoundation@gmail.com">isakhanfoundation@gmail.com</a><a href="tel:+8801819514684" lang="en">+880 1819 514684</a><a href={channelUrl}>{t('ISA KHAN FOUNDATION TV on YouTube', 'ইউটিউবে ISA KHAN FOUNDATION TV')}</a><a href={pathFor(lang, 'contact')}>{t('Enquiries and corrections', 'অনুসন্ধান ও তথ্য সংশোধন')}</a></div>
      </div>
      <div class="site-wrap footer-utility"><p>{t('Isha Kha Foundation · Website prototype', 'ঈশা খাঁ ফাউন্ডেশন · ওয়েবসাইটের প্রোটোটাইপ')}</p><nav aria-label={t('Website information', 'ওয়েবসাইটের তথ্য')}>
        {pages.filter(item => ['sources', 'privacy', 'accessibility', 'content-use', 'sitemap'].includes(item.slug)).map(item => <a href={pathFor(lang, item.slug)}>{item.title[lang]}</a>)}
      </nav></div>
    </footer>
  </body>
</html>
